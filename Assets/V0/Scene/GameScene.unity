  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::V0.Interaction.DoorInteractable
  _openPrompt: Open Door
  _closePrompt: Close Door
  _lockedPrompt: Locked (Need Key)
  _unlockPrompt: Unlock Door
  _isOpen: 0
  _isLocked: 0
