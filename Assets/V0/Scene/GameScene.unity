  _mainFrontDoorReference: {fileID: 0}
  _lockedDialogueLines:
  - text: '[Stranger Behind Door]: "Hey! That door is locked! You''ll need the key
      from our bedroom on the 2nd floor!"'
    color: {r: 1, g: 0.88, b: 0.6, a: 1}
    duration: 4.8
  - text: "[Stranger Behind Door]: \"Be careful... my crazy wife is guarding that
      key! And that bedroom door gets stuck from time to time\u2014you might have
      to force it open!\""
    color: {r: 1, g: 0.88, b: 0.6, a: 1}
    duration: 5.5
  - text: '[Player]: "2nd floor bedroom... got it. I need to watch out for her."'
    color: {r: 0.95, g: 0.95, b: 0.9, a: 1}
    duration: 3.5
  _objectToActivateOnLock: {fileID: 0}
  _objectToDeactivateOnUnlock: {fileID: 0}
