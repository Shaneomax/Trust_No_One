  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::V0.Cinematics.GoodEndingTrigger
  _lines:
  - text: '[Stranger]: "Don''t leave me... please... you can''t just leave me here!"'
    color: {r: 1, g: 0.88, b: 0.6, a: 1}
    duration: 4.5
  - text: '[Stranger]: "One day... I WILL get out of here... and I will haunt you
      for the rest of your life!"'
    color: {r: 1, g: 0.3, b: 0.3, a: 1}
    duration: 5.5
  - text: '[Player]: *stumbles back in terror, runs for the truck*'
    color: {r: 0.85, g: 0.85, b: 0.9, a: 1}
    duration: 3.5
  _goodEndingSceneName: GoodEnding
  _transitionDelay: 1.5
  _fadeDuration: 1.5
  _letterboxCanvasGroup: {fileID: 423030204}
  _subtitleText: {fileID: 2022090134}
  _playerController: {fileID: 1132628793}
  _playerInputs: {fileID: 1132628784}
