MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 575157068}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab93d7e10eb9c7b4e8e5c4935e4049e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::V0.Cinematics.StrangerDialogueCutscene
  _shots:
  - shotName: 1. Stranger Greeting
    virtualCamera: {fileID: 1871871561}
    duration: 5
    subtitleText: '[Stranger Behind Door]: "Hey! You! Over here! Please, you have
      to help me!"'
    textColor: {r: 1, g: 0.88, b: 0.6, a: 1}
    triggerDoorSlam: 0
    shakeCamera: 0
  - shotName: 2. Wife Locked Him In
    virtualCamera: {fileID: 1871871561}
    duration: 5.5
    subtitleText: '[Stranger Behind Door]: "My wife locked me in here with these
      chains... She lost her mind, she''s a crazy bitch!"'
    textColor: {r: 1, g: 0.88, b: 0.6, a: 1}
    triggerDoorSlam: 0
    shakeCamera: 0
  - shotName: 3. Chain Cutter In Dining Area
    virtualCamera: {fileID: 1871871561}
    duration: 6
    subtitleText: '[Stranger Behind Door]: "There''s a chain cutter in the dining
      area. Find it, break these chains, and I''ll get us out of here!"'
    textColor: {r: 1, g: 0.88, b: 0.6, a: 1}
    triggerDoorSlam: 0
    shakeCamera: 0
  - shotName: 4. Front Door Slam & Lock Event
    virtualCamera: {fileID: 1871871561}
    duration: 5
    subtitleText: '[Player]: "What the hell was that noise?! ...The front door just
      slammed shut!"'
    textColor: {r: 0.95, g: 0.95, b: 0.9, a: 1}
    triggerDoorSlam: 1
    shakeCamera: 1
  - shotName: 5. Stranger's Urgent Warning
    virtualCamera: {fileID: 1871871561}
    duration: 5.5
    subtitleText: '[Stranger Behind Door]: "She knows you''re in the house! Hurry,
      find that chain cutter before she finds you!"'
    textColor: {r: 1, g: 0.45, b: 0.45, a: 1}
    triggerDoorSlam: 0
    shakeCamera: 0
  _mainFrontDoor: {fileID: 533957764}
