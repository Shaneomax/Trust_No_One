  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::V0.Cinematics.GhostSpawnCutscene
  _shots:
  - shotName: 1. Ghost Awakens in Fog
    virtualCamera: {fileID: 1842978554}
    duration: 5
    subtitleText: '[Stranger Behind Door]: "Listen to me! She''s awake! Do NOT let
      her catch you!"'
    textColor: {r: 1, g: 0.45, b: 0.45, a: 1}
    activateGhost: 1
    shakeCamera: 1
  - shotName: 2. Player Disbelief
    virtualCamera: {fileID: 1842978554}
    duration: 4.5
    subtitleText: '[Player]: "What... what is that thing?! Is she even alive?!"'
    textColor: {r: 0.95, g: 0.95, b: 0.9, a: 1}
    activateGhost: 0
    shakeCamera: 0
  - shotName: 3. Stealth Warning & Rules
    virtualCamera: {fileID: 1842978554}
    duration: 6
    subtitleText: '[Stranger Behind Door]: "Her senses are sharp! Do NOT sprint; 
      She hears everything! Crouch and stay in the shadows!"'
    textColor: {r: 1, g: 0.88, b: 0.6, a: 1}
    activateGhost: 0
    shakeCamera: 0
  _ghostGameObject: {fileID: 1500852710}
