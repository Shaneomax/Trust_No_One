  - text: '[Stranger Behind Door]: "Ah, damn... that bedroom door is jammed shut!
      You''ll need a crowbar to force it open!"'
    color: {r: 1, g: 0.88, b: 0.6, a: 1}
    duration: 5
  - text: '[Stranger Behind Door]: "I know there''s a crowbar somewhere downstairs,
      but I can''t remember which room... You''ll have to search for it!"'
    color: {r: 1, g: 0.88, b: 0.6, a: 1}
    duration: 5.5
  - text: '[Player]: "A crowbar downstairs... got it. I need to search the rooms
      on the ground floor."'
    color: {r: 0.95, g: 0.95, b: 0.9, a: 1}
    duration: 4
